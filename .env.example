# Copy to .env and edit locally. Do not commit .env.

# Ollama. llama3.2:latest is already installed. Do not pull another model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest

# The installed model advertises a 128k window. Keep this small on 8 GB RAM.
OLLAMA_NUM_CTX=2048
# Cap generation so a reply stays short.
OLLAMA_NUM_PREDICT=128
# Keep the model loaded so later turns skip load time. Phase 12 warm-up.
OLLAMA_KEEP_ALIVE=30m

# Local speech only. No cloud STT or TTS keys.
# small is the largest Whisper model that fits beside the chat model on 8 GB RAM.
# CPU int8 leaves the 4 GB GPU for Ollama.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_RECORD_SECONDS=5
# One local Piper voice. Downloaded into voices/ on first use. Not committed.
PIPER_VOICE=en_US-lessac-medium
PIPER_VOICE_DIR=voices

# Phase 10. Off unless PLAYWRIGHT_ENABLED=1. Public pages only;
# signed-in browsing stays paused (needs the Playwright extension
# or Chrome remote debugging first).
# Web search does not use these values. It has no API key.
PLAYWRIGHT_MCP_COMMAND=npx
PLAYWRIGHT_MCP_ARGS=-y @playwright/mcp@latest --extension

# Filesystem MCP. Empty uses Documents, Downloads, and Desktop.
# On Windows, separate extra folders with a semicolon. Read-only.
FILESYSTEM_ROOTS=

# GitHub remote MCP. No local server and no Docker.
# Put a personal access token here. Do not commit the real value.
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# Google Calendar remote MCP. Official endpoint, read-only plus free-busy.
# Path to the Desktop-app client JSON from Google Cloud Console. Not committed.
# The refresh token is saved to data/google_token.json after one browser sign-in.
GOOGLE_CALENDAR_CLIENT_JSON=
CALENDAR_MCP_URL=https://calendarmcp.googleapis.com/mcp/v1

# Seconds
REQUEST_TIMEOUT=60

LOG_LEVEL=INFO
