# Copy to .env and edit locally. Do not commit .env.

# Ollama. llama3.2:latest is already installed. Do not pull another model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest

# The installed model advertises a 128k window. Keep this small on 8 GB RAM.
OLLAMA_NUM_CTX=2048
# Cap generation so a reply stays short.
OLLAMA_NUM_PREDICT=128

# Local speech only. No cloud STT or TTS keys.
# Faster Whisper model size is chosen in Phase 4 (small model for this laptop).
# WHISPER_MODEL=small
# Piper voice is chosen in Phase 5.
# PIPER_VOICE=

# Seconds
REQUEST_TIMEOUT=60

LOG_LEVEL=INFO
